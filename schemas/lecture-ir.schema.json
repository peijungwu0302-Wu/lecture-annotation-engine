{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-annotation-engine.dev/schemas/lecture-ir.schema.json",
  "title": "LectureIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "sourceRegions",
    "translations",
    "annotations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageSizePt", "orientation", "pageCount", "courseProfileRef", "languages"],
      "properties": {
        "pageSizePt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "orientation": { "enum": ["portrait", "landscape"] },
        "pageCount": { "type": "integer", "minimum": 1 },
        "courseProfileRef": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "targets"],
          "properties": {
            "source": { "type": "string", "minLength": 2 },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "sourceRegions": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRegion" }
    },
    "translations": {
      "type": "array",
      "items": { "$ref": "#/$defs/translation" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "$defs": {
    "bbox": {
      "description": "Normalized page coordinates in the closed interval [0, 1].",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageNumber", "bbox", "preferredPosition", "anchorType", "readingOrder", "logicalGroup"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "preferredPosition": { "enum": ["source", "below", "left", "right", "island", "footer"] },
        "anchorType": { "enum": ["fixed", "elastic-frame", "structural", "flow"] },
        "readingOrder": { "type": "integer", "minimum": 0 },
        "logicalGroup": { "type": "string", "minLength": 1 }
      }
    },
    "sourceInk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "geometryRef"],
      "properties": {
        "immutable": { "const": true },
        "geometryRef": { "type": "string", "minLength": 1 },
        "maskRef": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "geometry", "sourceInk"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
        "type": {
          "enum": [
            "heading", "paragraph", "definition", "example", "theorem", "result",
            "proof", "exercise", "figure", "equation", "caption", "footer",
            "header", "page-number", "source-artifact"
          ]
        },
        "text": { "type": "string" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "sourceInk": { "$ref": "#/$defs/sourceInk" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attachedSourceBlock", "targetLanguage", "text", "mathNormalized"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "attachedSourceBlock": { "type": "string", "minLength": 1 },
        "targetLanguage": { "type": "string", "minLength": 2 },
        "text": { "type": "string" },
        "mathNormalized": { "type": "boolean" }
      }
    },
    "layoutConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferredRegion", "collisionTolerance", "minimumClearanceMm", "movementAllowance"],
      "properties": {
        "preferredRegion": { "enum": ["nearby", "left-lane", "right-lane", "annotation-island", "footer-reserve"] },
        "collisionTolerance": { "enum": ["zero-source-ink", "soft-halo"] },
        "minimumClearanceMm": { "type": "number", "minimum": 0 },
        "movementAllowance": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "semanticAnchor", "priority", "preferredLane",
        "targetFontPt", "minimumFontPt", "text", "layoutConstraints"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "definition-intuition", "example-explanation", "proof-step", "exercise-solution",
            "result-meaning", "derivation", "figure-guide", "tip", "memory-cue",
            "common-mistake", "future-connection"
          ]
        },
        "semanticAnchor": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["required", "high", "optional"] },
        "preferredLane": { "enum": ["left", "right", "island", "nearby", "footer"] },
        "targetFontPt": { "type": "number", "minimum": 7, "maximum": 8 },
        "minimumFontPt": { "type": "number", "minimum": 5.5 },
        "text": { "type": "string" },
        "layoutConstraints": { "$ref": "#/$defs/layoutConstraints" }
      }
    }
  }
}
